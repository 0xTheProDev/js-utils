{
  "name": "@theprodev/react-hooks",
  "version": "0.1.0",
  "description": "A Collection of React Hooks for Modern Web Applications",
  "keywords": [
    "browser",
    "javascript",
    "nextjs",
    "nodejs",
    "remix",
    "react",
    "tanstack",
    "typescript",
    "web"
  ],
  "bugs": {
    "url": "https://github.com/0xTheProDev/js-utils/discussions"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xTheProDev/js-utils.git"
  },
  "license": "MIT",
  "author": "Progyan Bhattacharya <bprogyan@gmail.com>",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --check \"./**/*.{cjs,js,json,md,mjs,ts,yaml,yml}\"",
    "format:fix": "prettier --write \"./**/*.{cjs,js,json,md,mjs,ts,yaml,yml}\"",
    "lint": "eslint \"./**/*.{cjs,js,mjs,ts}\"",
    "lint:fix": "eslint --fix \"./**/*.{cjs,js,mjs,ts}\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect --inspect-brk --logHeapUsage --threads=false",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@theprodev/prettier-config",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "publishConfig": {
    "access": "public"
  }
}
