{
  "name": "js-utils",
  "private": true,
  "description": "A Collection of JavaScript/TypeScript Utility and Functions useful for NodeJS and Web Projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xTheProDev/js-configs.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "create": "hygen package new",
    "dev": "turbo dev",
    "dev:debug": "turbo run dev:debug",
    "dev:nest": "turbo dev --filter=nest-example-app",
    "dev:nest:debug": "turbo run dev:debug --filter=nest-example-app",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "bun run .husky/install.mjs",
    "publish": "turbo run publish",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@nestjs/testing": "11.1.26",
    "@swc/core": "1.15.41",
    "@theprodev/eslint-config": "0.3.1",
    "@theprodev/prettier-config": "0.1.0",
    "@theprodev/tsconfigs": "0.3.0",
    "@theprodev/tsup-config": "0.4.0",
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "4.1.8",
    "check-yarn-lock": "0.2.1",
    "eslint": "10.4.1",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "sort-package-json": "4.0.0",
    "tsup": "8.5.1",
    "turbo": "2.9.17",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "packageManager": "yarn@1.22.0",
  "engines": {
    "node": ">= 20"
  }
}
